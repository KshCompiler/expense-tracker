# Only needed for production deployments where the frontend and backend are
# on different domains (e.g. frontend on Vercel, backend on Railway). Set this
# in the Vercel project's environment variables, not in a committed file.
# Leave unset for local dev - the Vite dev server proxies /api to localhost:5001.
# VITE_API_URL=https://your-backend.up.railway.app
