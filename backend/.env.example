GROQ_API_KEY=your-groq-api-key-here

# Optional: override the vision-capable Groq model used to read uploaded bills
# on the Add Expense / Add Income pages. Only needed if the default stops working.
# BILL_OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Secret used to sign JWT access-token cookies. Must be set to a long random
# value in production - do not reuse the example value below.
SECRET_KEY=dev-secret-key-change-in-production

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173

# Set to true only when serving over HTTPS in production - browsers silently
# drop Secure cookies on plain HTTP (including local dev).
COOKIE_SECURE=false

# Optional: SMTP settings for sending password-reset emails (Forgot Password
# feature). If SMTP_HOST is left unset, forgot-password requests still return
# the generic success message, but no email is actually sent - the failure is
# logged server-side only and never surfaces to the client.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=no-reply@spendly.example.com
# SMTP_USE_TLS=true

# Base URL of the deployed frontend, used to build the link emailed to users
# for the Forgot Password flow.
# FRONTEND_BASE_URL=http://localhost:5173

# How long a password-reset link stays valid, in minutes.
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Google and Microsoft OAuth login (optional - a provider's button redirects
# to a clear error instead of crashing if its credentials are unset).
# Register callbacks in each provider's console:
#   Google:    http://localhost:5001/api/auth/google/callback
#   Microsoft: http://localhost:5001/api/auth/microsoft/callback
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# BACKEND_BASE_URL=http://localhost:5001
