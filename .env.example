GROQ_API_KEY=your-groq-api-key-here

# Optional: override the vision-capable Groq model used to read uploaded bills
# on the Add Expense page. Only needed if the default below stops working.
# BILL_OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Production deployment (e.g. backend on Railway) ---
# SECRET_KEY=replace-with-a-long-random-value
# Comma-separated list of allowed frontend origins, e.g. your Vercel URL.
# CORS_ORIGINS=https://your-app.vercel.app
# Required (true) once the backend is served over HTTPS.
# COOKIE_SECURE=true
# Only needed when the frontend and backend are on different domains
# (e.g. Vercel + Railway) - "strict" is fine when they share an origin.
# Must be "none" together with COOKIE_SECURE=true, never "none" alone.
# COOKIE_SAMESITE=none

# --- Google and LinkedIn OAuth login (optional) ---
# Register an OAuth app in Google Cloud Console and the LinkedIn Developer
# Portal (product: "Sign In with LinkedIn using OpenID Connect"), and set
# these exact callback URLs in each provider's console for local dev:
#   Google:   http://localhost:5001/api/auth/google/callback
#   LinkedIn: http://localhost:5001/api/auth/linkedin/callback
# Leave a provider's id/secret unset to disable that provider's login button
# gracefully (its row still renders on Login/Register, but clicking it shows
# a clear error instead of crashing).
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# LINKEDIN_CLIENT_ID=your-linkedin-oauth-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-oauth-client-secret
# Base URL the backend itself is reachable at - used to build the fixed
# redirect_uri sent to each provider above. Change only if the backend isn't
# on localhost:5001 (e.g. production, alongside CORS_ORIGINS above).
# BACKEND_BASE_URL=http://localhost:5001
