GROQ_API_KEY=your-groq-api-key-here

# Optional: override the vision-capable Groq model used to read uploaded bills
# on the Add Expense page. Only needed if the default below stops working.
# BILL_OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Production deployment (e.g. backend on Railway) ---
# SECRET_KEY=replace-with-a-long-random-value
# Comma-separated list of allowed frontend origins, e.g. your Vercel URL.
# CORS_ORIGINS=https://your-app.vercel.app
# Required (true) once the backend is served over HTTPS.
# COOKIE_SECURE=true
# Only needed when the frontend and backend are on different domains
# (e.g. Vercel + Railway) - "strict" is fine when they share an origin.
# Must be "none" together with COOKIE_SECURE=true, never "none" alone.
# COOKIE_SAMESITE=none
